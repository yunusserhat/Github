# Supabase Configuration for Office Hours Booking System
# For client-side access in Hugo and Netlify builds:
# Set these variables in Netlify UI: Site settings > Environment variables
# Or populate your local .env file when developing locally (do NOT commit .env)

# Public URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Public / Anon Key (safe for browser usage with Supabase Row Level Security enabled)
SUPABASE_ANON_KEY="your-supabase-anon-key"

# OPTIONAL: public Cloudflare Turnstile site key for Supabase Auth CAPTCHA.
# Leave unset until the CAPTCHA step in supabase/RELEASE_CHECKLIST.md; the matching
# Turnstile secret key belongs only in Supabase (Authentication > Attack Protection).
# OFFICEHOURS_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# Netlify Functions only: keep these out of Hugo templates and browser code.
RESEND_API_KEY="your-resend-api-key"
OFFICEHOURS_WEBHOOK_SECRET="your-long-random-shared-secret"

# OPTIONAL: Privileged service role key (for administrative scripts or migration runners only)
# NEVER expose this key to client-side code, Hugo templates, or public repositories!
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
